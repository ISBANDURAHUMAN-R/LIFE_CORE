# ==============================================
# LIFE_CORE System Environment Configuration
# ==============================================

# Database Connection (SQLite default, PostgreSQL/MySQL compatible)
DATABASE_URL=sqlite:///./lifeos.db

# Backend Security & Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Next.js Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
